{
  "name": "docinspector",
  "version": "0.10.0",
  "private": true,
  "description": "DocInspector PWA - authenticated field-ready release",
  "scripts": {
    "build": "node -e \"console.log('Static app: no build step required.')\"",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:sql": "node scripts/check-sql.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:automation": "node scripts/check-automation-contracts.mjs",
    "check": "npm run check:syntax && npm run check:sql && npm run check:secrets && npm run check:automation && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
